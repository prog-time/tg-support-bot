APP_NAME=Laravel
APP_ENV=
APP_KEY=
APP_DEBUG=

MAIN_DOMAIN=
APP_URL=

#-----------------------
# БАЗА ДАННЫХ
#-----------------------
DB_CONNECTION=pgsql
DB_HOST=pgdb
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#-----------------------
# DOCKER
#-----------------------
SYSTEM_TIMEZONE=UTC

NGINX_PORT=
# 443:443 — container nginx terminates TLS on public HTTPS.
# 127.0.0.1:8443:443 — TLS off / external proxy (keeps public host :443 free).
NGINX_HTTPS_PORT=

PGDB_PORT=5432:5432

# Optional Docker image knobs (Makefile sets sensible defaults from APP_ENV):
# IMAGE_TAG=local
# DOCKERFILE_TARGET=app       # production — no Node in image
# DOCKERFILE_TARGET=app-dev   # local — Node/npm for `make shell` + vite

#-----------------------
# LARAVEL TELESCOPE
#-----------------------
TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope

# Records outbound HTTP (URL + headers + body) verbatim. Our credentials travel
# inside those requests — the Telegram token is part of the URL — so enabling
# this writes them to telescope_entries in plaintext. Leave off outside local
# debugging with throwaway credentials.
TELESCOPE_CLIENT_REQUEST_WATCHER=false

# Telegram IPv4 force flag (infrastructure / deployment — stays in .env)
TELEGRAM_FORCE_IPV4=
